  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "25 de enero 1980 \r\n\r\nNota de campo 335: \r\n\r\nLa investigaci\xF3n
    ha sido un \xE9xito, he vuelto al pueblo para examinar las muestras de tejido
    que he encontrado, parece una extremidad, arrancada de un mordisco, pero la forma
    de la mordida no coincide con ning\xFAn animal conocido, no ha sido un lobo,
    ni tampoco un oso. \r\n\r\n26 de enero 1980 \r\n\r\nNota de campo 336: \r\n\r\nTras
    8 horas de examen, el tejido tampoco pertenece a ning\xFAn animal conocido, es
    de piel p\xE1lida, casi como la nieve, pero aqu\xED est\xE1 lo interesante, las
    c\xE9lulas del tejido est\xE1n v\xEDas, incluso tras dias despu\xE9s de ser arrancado.
    Parece un brazo humano, pero las garras y las c\xE9lulas no coinciden. Es otra
    cosa, estoy ante un descubrimiento cient\xEDfico nunca antes visto. \r\n\r\n29
    de enero 1980 \r\n\r\nNota de campo 338: \r\n\r\nMi teor\xEDa del tejido vivo
    es cierto, hoy mismo el brazo se ha movido al examinarlo y me ha ara\xF1ado.
    Ayer no tenia u\xF1as, ni dedos, hoy era casi un brazo entero. Sea de lo que
    sea, esta cosa sigue viva, Y NO ES UN VAMPIRO. Viene a por m\xED, oigo ese brazo
    moverse dentro de la casa. Ma\xF1ana partir\xE9, de vuelta al bosque. \r\n\r\nIvanov
    \u2013 Dios\u2026"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
